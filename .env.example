# Heart of Virtue — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# -------------------------------------------------------
# Flask
# -------------------------------------------------------
# ⚠️  REQUIRED IN PRODUCTION — shipped blank on purpose, exactly like
# ENCRYPTION_KEY below. Config.runtime_config() refuses to start when
# FLASK_ENV=production and this is empty; a placeholder *value* here would be a
# published, non-empty string that satisfies that guard, so every deployment
# that copied this file would share one committed secret and the guard would
# report success while doing nothing. Blank fails closed.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ⚠️  REQUIRED IN PRODUCTION — the app will refuse to start without it.
# When FLASK_ENV=production and ENCRYPTION_KEY is unset, AuthService raises at
# import time (fail-closed): an ephemeral key would silently orphan every
# already-encrypted user email on each restart. Set this ONCE and keep it
# stable — rotating it makes existing encrypted data unrecoverable.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Selects the config class (development / testing / production) and, with it,
# DEBUG, the CORS origin allowlist and the secure-cookie setting. Compared
# case-insensitively; anything unrecognised falls back to development.
# There is deliberately no FLASK_DEBUG knob: every config class pins DEBUG, so
# the variable never had any effect.
FLASK_ENV=development

# Interface the dev server (tools/run_api.py) binds to. 127.0.0.1 by default,
# and that default is load-bearing: with DEBUG on, Werkzeug serves an
# interactive `/console` (PIN-gated only) and a full source traceback on every
# 500, so 0.0.0.0 hands those to everything on the LAN. And with
# FLASK_ENV=testing it also serves /api/test/session (a valid session for any
# username, no credentials) and the whole /api/debug/* blueprint.
# HOST=127.0.0.1

# Second key required before tools/run_api.py will bind a non-loopback HOST.
# HOST alone no longer does it: a value set once for a LAN demo, or inherited
# from a .env copied between machines, is not an operator deciding *today* to
# publish an interactive Python console and an unauthenticated state editor.
# Two keys means the exposure has to be asked for twice. Accepts 1/true/yes/on;
# ignored entirely when HOST is a loopback address (the default).
# ALLOW_REMOTE_DEV_SERVER=0

# Number of trusted reverse-proxy hops in front of the app (issue #409). 0 —
# the default — means no proxy is trusted, so request.remote_addr stays the
# direct peer and a client cannot forge X-Forwarded-For to mint a fresh
# rate-limit bucket. Set it to the real hop count (e.g. 1 behind a single
# platform proxy) when deploying behind one, or every throttle buckets the
# whole internet under the proxy's address.
# TRUSTED_PROXY_COUNT=0

# Engine-driven combat streaming over SocketIO (issue #436). Off by default:
# combat then resolves through the existing lump-response replay path. On, the
# engine streams per-beat events the frontend animates in lockstep. Surfaced to
# the frontend at GET /api/info as features.combat_socket_streaming.
# COMBAT_SOCKET_STREAMING=false

# Log verbosity for this project's own loggers (the `src` and `ai` namespaces
# — third-party wire logging is deliberately left at its own default). One of
# CRITICAL / ERROR / WARNING / INFO / DEBUG; anything else logs a warning and
# falls back to WARNING. Unset means "leave logging levels alone", which is
# Python's WARNING default.
#
# NOTE: this file is loaded by the test suite too (src/api/db.py calls
# load_project_env() at import). LOG_LEVEL=DEBUG here would therefore slow
# every test run, which is why create_app() pins WARNING for TESTING configs
# whenever LOG_LEVEL is set.
# LOG_LEVEL=WARNING

# Optional second log destination, rotated at 5 MB with three backups. Must
# resolve to a path under <repo>/logs/ — a relative value is interpreted there
# — because the handler creates parent directories and rotation *renames*
# X -> X.1 -> X.2 over whatever else is sitting under that name.
# At DEBUG this file will contain NPC-chat records carrying player-typed
# conversation text.
# LOG_FILE=hov.log

# Log whole model completions instead of their first 80 characters. Off by
# default, and deliberately its own switch rather than something LOG_LEVEL=DEBUG
# turns on: the truncated head already says what shape came back (fenced or
# bare, JSON or prose), while everything past it is the completion itself --
# which on the NPC-chat path is the conversation the player is having. With
# LOG_FILE set, that lands on disk. Accepts 1 / true / True.
# LLM_LOG_RAW_BODIES=0

# -------------------------------------------------------
# Database (Turso / LibSQL)
# -------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# -------------------------------------------------------
# AI integration (Mynx NPC ambient behavior)
# Set MYNX_LLM_ENABLED=0 to disable entirely — no API key needed.
# -------------------------------------------------------
MYNX_LLM_ENABLED=0
MYNX_LLM_PROVIDER=openrouter

# Model id for the chosen provider. "auto" -- the default -- means "whatever
# discovery picks", which for Ollama is the best model actually installed and
# for OpenRouter is the top-ranked free model in the nightly catalogue. NPC chat
# and combat inherit this value when their own *_LLM_MODEL is unset, so naming
# one model here configures all three.
# MYNX_LLM_MODEL=auto

# Narrate Mynx adapter diagnostics in-game: why the adapter refused to load
# (gate off, module missing, availability probe raised), or its full
# debug_status -- provider, model, availability -- once it did. The output goes
# to the player's screen, so this is a development switch, not a production one.
# Default 0; accepts 1 / true / True.
# MYNX_LLM_DEBUG=0

# Seconds Mynx pauses after speaking an unstructured (terminal-mode) reply, so
# a wall of generated text does not land in one frame. Default 1.5; 0 removes
# the pause entirely, which is what the test suite sets.
# MYNX_FALLBACK_DELAY=1.5

# The separate master gate for *human* NPC conversation (the /api/npc/chat
# feature), as opposed to Mynx's ambient behaviour above. Off by default:
# unset or "0" and the chat adapter refuses to assemble at all, so no player
# dialogue can leave the process however many keys are filled in below. The
# API's own NPC serializer reads it too, to tell the frontend whether a given
# NPC can be talked to.
NPC_CHAT_LLM_ENABLED=0

# OpenRouter (preferred). Its free tier is metered and account-wide across
# every :free model, so when it is spent the chain below is what keeps NPC chat
# from dropping to canned dialogue. Its ceilings are NOT stated here, for the
# reason given under "Additional OpenAI-compatible providers" below. The one
# measured account of them lives in .claude/rules/llm-prompts.md.
OPENROUTER_API_KEY=

# Optional public attribution sent with every OpenRouter request as HTTP-Referer
# and X-Title, which is what puts an app on OpenRouter's usage leaderboards.
# Both are omitted from the request entirely when unset -- an empty X-Title is
# not the same request as no X-Title -- so leaving them blank is the private
# default, not a broken header.
# OPENROUTER_SITE=
# OPENROUTER_SITE_TITLE=

# Additional OpenAI-compatible providers, tried in order after the configured
# one. Each is skipped entirely unless its key is set, so leaving these blank
# costs nothing. Free-tier ceilings differ per provider, so a wall at one is
# rarely a wall at the others -- but the ceilings are NOT restated here. The one
# measured account of them lives in .claude/rules/llm-prompts.md; a copy in this
# file had already drifted into advertising a ceiling a bare free account cannot
# actually reach. tools/measure_llm_tokens.py declines to keep a copy for the
# same reason.
#
# IMPORTANT — a key alone does not arm the fallback chain. This file is loaded
# process-wide, so a credential present here for one feature is not consent to
# send another feature's traffic to that host. The chain is only assembled when
# a provider is named EXPLICITLY: set MYNX_LLM_PROVIDER (or, for NPC chat,
# NPC_CHAT_LLM_PROVIDER / for combat, COMBAT_LLM_PROVIDER). Leave the provider
# unset and that feature stays on the local default and never reaches a remote
# host, however many keys are filled in below. Set it to "none" to disable the
# feature outright.
#
# Naming "ollama" is likewise a decision, and it means what it says: NPC chat
# pinned to the local host stays on the local host, and a dead or empty Ollama
# degrades to canned dialogue rather than quietly shipping the player's
# conversation to whichever remote key is sitting in this file. "Which host"
# and "may this leave the machine" are two questions, so they have two
# settings — set NPC_CHAT_LLM_FALLBACK=1 if you do want the remote chain behind
# a local primary.
NPC_CHAT_LLM_FALLBACK=0
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Local Ollama, tried last when set (no key needed).
OLLAMA_BASE_URL=

# Skip a provider once this fraction of its free tier is spent, rather than
# spending a round trip to be told what its own headers already said. The block
# lifts at the reset the provider reported, or after an hour if it reported none.
LLM_SATURATION_CUTOFF=0.90

# Discord incoming webhook for the provider-usage digest. Unset = feature off,
# and no scheduler thread is started at all.
#   HOV_ANALYTICS_SECTIONS         narrows the embed (saturation,traffic,reliability)
#   HOV_ANALYTICS_INTERVAL_HOURS   routine cadence (default 168 = weekly; 0 disables)
#   HOV_ANALYTICS_ALERT_INTERVAL_HOURS
#                                  cadence while headroom is low (default 1)
#   HOV_ANALYTICS_ALERT_THRESHOLD  saturation that escalates to the alert cadence
#                                  (default 0.75). This is measured against the
#                                  LEAST saturated provider, so it trips only
#                                  when every reporting provider is that spent —
#                                  one host with room means the chain is fine.
HOV_ANALYTICS_WEBHOOK_URL=
HOV_ANALYTICS_SECTIONS=
HOV_ANALYTICS_INTERVAL_HOURS=
HOV_ANALYTICS_ALERT_INTERVAL_HOURS=
HOV_ANALYTICS_ALERT_THRESHOLD=

# Anthropic direct
ANTHROPIC_API_KEY=

# OpenAI direct
OPENAI_API_KEY=

# -------------------------------------------------------
# GitHub Feedback Integration
# Personal Access Token with issues:write scope on azureknight63/heart-of-virtue
# Without this, the in-game Feedback button returns a 503 (game is unaffected).
# -------------------------------------------------------
GITHUB_TOKEN=

# -------------------------------------------------------
# Deployment (deploy.ps1 only)
# SSH password for alex@nexusfidei.dev. deploy.ps1 reads it from .env and
# exports it as SSHPASS; nothing in the game or the API touches it.
# Only needed on a machine that actually deploys -- leave blank otherwise.
#
# Listed here, blank, rather than left to .env: .env is gitignored, so CI and
# tests/test_credential_blanking.py see only this file, and a credential this
# file omits is a credential nothing checks is blanked. That check is why this
# entry exists at all -- NEXUS_PASS was in OUTBOUND_CREDENTIAL_ENVS and in the
# developer's .env, but invisible to the guard everywhere else.
# -------------------------------------------------------
NEXUS_PASS=

# -------------------------------------------------------
# NPC Chat (human NPC conversations)
# The master gate is NPC_CHAT_LLM_ENABLED, above. Everything here is inert
# while that is off.
# -------------------------------------------------------
# Host for player dialogue specifically. Unset means "inherit
# MYNX_LLM_PROVIDER", and inheriting is deliberately not the same as choosing:
# only a value set HERE counts as an explicit choice, and only an explicit
# choice arms the remote fallback chain for chat. That distinction is what stops
# a credential present in this file for the mynx pet from silently routing
# player-authored prose to the same host. "none" disables chat outright.
# NPC_CHAT_LLM_PROVIDER=

# Model id for the chat provider. Unset inherits MYNX_LLM_MODEL, then "auto".
# NPC_CHAT_LLM_MODEL=

# Per-call network timeout in seconds. A healthy free model answers a
# conversation round in ~2-4s, so the default covers the slow-but-fine tail
# while a genuinely stuck call aborts into the deterministic fallback dialogue
# rather than leaving the player staring at a spinner. Default 6.0.
# NPC_CHAT_LLM_TIMEOUT=6.0

# Sampling temperature per pipeline stage. The chat pipeline makes several
# differently-shaped calls and they do not want the same setting: generation
# wants range, the corrective pass does not (a creative reviser re-offers the
# same thing in fresh words). Raise these for more variety and more drift;
# lower them for flatter, more repetitive, more on-spec output.
#   NPC_CHAT_TEMP_PERSONALITY  first-contact NPC personality sheet   (0.7)
#   NPC_CHAT_TEMP_NPC          the NPC's own dialogue turn           (0.65)
#   NPC_CHAT_TEMP_TURN         combined turn: reply + Jean's options (0.7)
#   NPC_CHAT_TEMP_GUARD        QC pass that rewrites a bad turn      (0.5)
#   NPC_CHAT_TEMP_OPTIONS      standalone regeneration of options    (0.8)
# NPC_CHAT_TEMP_PERSONALITY=0.7
# NPC_CHAT_TEMP_NPC=0.65
# NPC_CHAT_TEMP_TURN=0.7
# NPC_CHAT_TEMP_GUARD=0.5
# NPC_CHAT_TEMP_OPTIONS=0.8

# Requests/minute allowed on the LLM-backed npc-chat endpoints (POST /open,
# POST /respond), bucketed per player. The bucket is the first of these the
# session can supply: database user id, then username, then session id, then
# client IP (`_chat_rate_limit_key` in src/api/routes/npc_chat.py). The user id
# leads because it survives re-login; a session id is re-minted on every login,
# so a bucket keyed on it could be reset at will. One request can drive a dozen
# provider calls through the fallback chain, so this protects the operator's
# shared free-tier LLM quota from a single client hammering the endpoint.
# Default 10; 0 disables this tier.
# NPC_CHAT_RATE_LIMIT_PER_MINUTE=10

# Second npc-chat tier, keyed on source IP alone, so an attacker who can log in
# repeatedly cannot buy a fresh per-player budget each time. Set well above
# what several players behind one NAT produce. Default 40; 0 disables this
# tier. Set both npc-chat vars to 0 to turn chat throttling off entirely.
# NPC_CHAT_IP_RATE_LIMIT_PER_MINUTE=40

# -------------------------------------------------------
# Rate limits (login + registration + feedback + browser logs)
# All limits below share one parser: a garbled or negative value logs a warning
# and falls back to the default rather than being read as "unlimited". Every
# limit is per Gunicorn worker, not shared across them (GitHub issue #284), so
# the effective ceiling is the value here times the worker count.
#
# The two LOGIN_* limits are threshold-only knobs: unlike the npc-chat and
# feedback limits, 0 does NOT disable them. They are the brute-force defence on
# the credential path, so a 0 there — typed, or copied out of a dev .env — logs
# a warning and falls back to the default instead of silently removing the
# protection.
# -------------------------------------------------------
# Failed logins per username+IP per 15 minutes. Successful logins never count,
# and a success clears the account's counter. Default 10; cannot be disabled.
# LOGIN_RATE_LIMIT_PER_15_MIN=10

# Failed logins per IP per 15 minutes, regardless of username — this is the
# tier that catches credential stuffing across many accounts. A successful
# login deliberately does NOT clear it. Default 60; cannot be disabled.
# LOGIN_IP_RATE_LIMIT_PER_15_MIN=60

# Account creations per client IP per hour. There is no account to key on yet,
# so the source address is the only tier available. The ceiling is deliberately
# far above any human and far below an account farm; unlike the two LOGIN_*
# tiers this one IS disableable, because its absence is spam and cost rather
# than an open door to credential guessing. Default 30; 0 disables the limiter.
# REGISTER_RATE_LIMIT_PER_HOUR=30

# In-game feedback submissions per client IP, and per account when logged in,
# per hour (each one files a GitHub issue). Deliberately NOT keyed on the
# session id: a client mints a fresh one on every login, so that key was
# bypassed simply by re-authenticating between submissions. Default 10;
# 0 disables the limiter.
# FEEDBACK_RATE_LIMIT_PER_HOUR=10

# Browser-log posts (POST /api/logs/browser) per client IP per minute. That
# route has no authentication and no session — the frontend logger posts to it
# unauthenticated, including via sendBeacon on unload — so the source address
# is the only tier available and this throttle is its entire admission control.
# Each accepted post writes to disk and can drive the 100 MB retention sweep,
# which evicts the OLDEST files first, so an unthrottled flood costs real logs
# as well as disk. Default 60 (the frontend's own 5s flush timer is 12/min);
# 0 disables the limiter.
# BROWSER_LOG_RATE_LIMIT_PER_MINUTE=60

# -------------------------------------------------------
# Combat Tactical Advisor (LLM move suggestions during battle)
# -------------------------------------------------------
# Unlike NPC chat, all three of these fall back to their MYNX_ equivalents when
# unset, and that asymmetry is deliberate: chat ships player-authored prose to a
# third party, while the advisor reads a battlefield this engine produced. The
# advisor was gated on MYNX_LLM_ENABLED alone before it had its own name, so
# dropping the fallback would switch it off on every existing install at
# upgrade. An explicit COMBAT_LLM_ENABLED=0 still wins over MYNX_LLM_ENABLED=1.
#
# COMBAT_LLM_PROVIDER accepts "ollama" or "openrouter" only. The advisor uses
# the base client, which routes those two; it does not dispatch the groq /
# cerebras fallback chain the way NPC chat does, and naming one of those makes
# it report "Unknown provider" and fall back to the deterministic scorer.
# COMBAT_LLM_ENABLED=
# COMBAT_LLM_PROVIDER=
# COMBAT_LLM_MODEL=

# -------------------------------------------------------
# Saves
# -------------------------------------------------------
# Write the JSON v2 save document alongside the pickle save. Off by default: the
# sidecar is additive (the pickle stays authoritative) and costs a second write
# per save. Accepts 1 / true / yes / on.
# HOV_SAVE_V2=0

# Enforce the unpickler's engine-module rule strictly. Off by default, where an
# unrecognised global in a save degrades to a placeholder so old saves keep
# loading; on, secure_pickle._is_allowed rejects outright anything that is not a
# global from an engine module (classes AND functions/methods) or in the curated
# legacy/stdlib sets. Note it is _is_allowed that gates, not get_allowlist() --
# that returns a class inventory used for drift detection, and nothing on the
# save-load path consults it. Calling this "the class allow-list" promises
# something narrower than the loader delivers. Accepts 1 / true / yes / on.
# HOV_STRICT_UNPICKLE=0

# -------------------------------------------------------
# Optional
# -------------------------------------------------------
# Path to a .ini config file for map/starting-position overrides
# CONFIG_FILE=config_dev.ini

# Server port (defaults to 5000)
# PORT=5000

# -------------------------------------------------------
# Inquisitor report email (tools/inquisitor.py)
# -------------------------------------------------------
# These seven were read by tools/inquisitor/email_reporter.py and declared
# NOWHERE -- so nothing classified them, nothing blanked them, and a harness run
# with them set in a developer's .env would authenticate to a real SMTP server
# and post the findings report off-box. That is the same shape as the GitHub,
# Turso and provider-credit incidents; it was found by
# tests/test_credential_blanking.py's "every name the CODE reads is DECLARED
# here" scan on its first run, which is the whole reason that scan exists.
#
# INQUISITOR_REPORT_EMAIL is the gate: unset (or blanked), send_report() returns
# immediately and nothing else here is consulted.
# INQUISITOR_REPORT_EMAIL=
# INQUISITOR_FROM_EMAIL=inquisitor@heart-of-virtue.local
# INQUISITOR_SMTP_HOST=localhost
# INQUISITOR_SMTP_PORT=587
# INQUISITOR_SMTP_USER=
# INQUISITOR_SMTP_PASSWORD=
# Use STARTTLS: "1" (default) or "0". Anything that is not "0" means yes, so a
# blanked value keeps TLS on -- the safe direction.
# INQUISITOR_SMTP_TLS=1
