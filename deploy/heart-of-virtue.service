# The production API's systemd unit, mirrored from the server
# (/etc/systemd/system/heart-of-virtue.service on nexusfidei.dev, read
# 2026-09-19). THIS is the process model production runs; the Procfile is a
# convenience copy of the same command and tests/test_npc_chat_turn_budget.py
# holds the two to each other.
#
# `deploy.ps1` does NOT install this file -- it restarts the unit that is
# already there. Changing the flags below therefore means copying this file to
# the server and running `systemctl daemon-reload && systemctl restart
# heart-of-virtue`; otherwise the repo says one thing and the server does
# another, which is exactly what this file exists to stop (the NPC chat turn
# budget was sized against the Procfile's sync worker and 30s default, neither
# of which production uses).
#
# Why the flags matter to application code:
#   gthread worker            many requests are served CONCURRENTLY in one
#                             process, on real OS threads. Two requests from
#                             one player can interleave, which is what
#                             GameService's chat-turn and inventory locks are
#                             for. It replaced the eventlet worker on
#                             2026-09-26: eventlet's monkey-patching hung
#                             asyncio DB calls on Python 3.13 (#726), and
#                             src/api/db.py's one-loop client cannot run under
#                             it. tests/test_npc_chat_turn_budget.py rejects a
#                             patching worker here.
#   --threads 32              the concurrency limit. A chat turn can hold a
#                             thread for ~21s and every connected Socket.IO
#                             client holds one while connected (the combat
#                             socket is off in production today).
#   -w 1                      one process, and sessions live in its memory.
#                             Raising this breaks sessions until they move to
#                             shared storage.
#   --timeout 120             for a NON-sync worker this is a liveness
#                             heartbeat, not a per-request deadline: a long
#                             request does not kill the worker, but a stalled
#                             main loop does, at 120s.
[Unit]
Description=Heart of Virtue Flask API
After=network.target docker.service

[Service]
User=alex
WorkingDirectory=/home/alex/heart-of-virtue
EnvironmentFile=/home/alex/heart-of-virtue/.env
# Binds all interfaces, but ufw only admits port 5000 from the Docker network (nginx).
ExecStart=/home/alex/heart-of-virtue/.venv/bin/gunicorn \
    --worker-class gthread -w 1 --threads 32 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    --access-logfile /var/log/heart-of-virtue/access.log \
    --error-logfile /var/log/heart-of-virtue/error.log \
    wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
